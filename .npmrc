# expo-router is an *optional* peer dependency of @expo/cli, which npm's
# strict peer resolution doesn't hoist consistently in workspaces — and
# Expo's monorepo-aware Metro config resolves bundle entries relative to
# the workspace root, so expo-router needs to actually be hoisted there
# (see the root package.json "dependencies" phantom entry). legacy-peer-deps
# avoids ERESOLVE conflicts that strict mode raises over this.
legacy-peer-deps=true
