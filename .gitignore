# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Note: app-specific ignores (Next.js build output, scripts/ data artefacts,
# supabase/.temp/, etc.) live in apps/web/.gitignore since that's where those
# directories now live.

# dependencies (npm workspaces hoists here too)
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Claude Code lokal state (må aldrig committes)
.claude/

# Interne working-docs (ikke til partnere)
MGP_Partner_Guide_Courses_Database.docx
danish-club-validation.xlsx

# Cowork-Claude workspace area (cross-session read scratchpad)
My Golf Passport - build project/
